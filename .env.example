# Chat LLM — src/config.py reads these. Do not edit graph.py / search.py to switch models.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_PROVIDER=ollama
LLM_FALLBACK_MODEL=qwen2.5:7b

GROQ_API_KEY=gsk_your_key_here
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Later: LLM_PROVIDER=openai LLM_MODEL=gpt-4o-mini  (+ uv add langchain-openai)
# Later: LLM_PROVIDER=anthropic LLM_MODEL=claude-sonnet-4-5  (+ uv add langchain-anthropic)
# Disable fallback: LLM_FALLBACK_PROVIDER=


# Optional - Langsmith tracing (set Langsmith = True to enable)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=ls_your_key_here
LANGSMITH_PROJECT=rag-pro

# Optional - chunking (character counts; 500/50 fits all-MiniLM-L6-v2's 256-token window)
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50

# Optional - drop weak rerank hits (ms-marco: relevant often > 0; a unique
# winner below 0 is still kept if it beats the rest by RERANK_SCORE_MARGIN)
# MIN_RERANK_SCORE=0
# RERANK_SCORE_MARGIN=3

# Optional - rewrite uses only the last N chat messages (10 = 5 turns)
# REWRITE_HISTORY_MESSAGES=10

# Unused for he/she. Follow-ups resolve pronouns from chat history only.
# QUERY_IDENTITY=

# Eval uses LLM_PROVIDER, then LLM_FALLBACK_PROVIDER on 429s.
# With LANGSMITH_TRACING=true it upserts dataset rag-pro-own-docs.
